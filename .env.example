# Copy to .env (git-ignored; run_app.sh does this for you) and fill in. Never commit real secrets.
# (Variables were renamed to PAYTRACE_*; a .env written before the rename still works unchanged.)

# ---- AI explanations (optional; template text is used without a key) ----
# Free option 1 (recommended): Google Gemini. Get a key at https://aistudio.google.com/apikey (Google account, no card).
#   Note: on the free tier Google may use prompts to improve its products. Only synthetic data is sent here.
GEMINI_API_KEY=
# Leave blank to use gemini-3.8-flash; if Google retires a model the app switches to the newest Flash automatically
GEMINI_MODEL=
# Free option 2: Groq. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Force one provider when several keys are set: gemini | groq
LLM_PROVIDER=
# Max seconds a customer payment waits for an LLM-written message before using the template
LLM_CUSTOMER_TIMEOUT=6

# ---- Web app security ----
# Session signing key. Leave empty to auto-generate one into .secret_key (git-ignored).
PAYTRACE_SECRET=
# Password for the demo accounts created on first start. Setting it also hides the demo-account list on the login page.
PAYTRACE_DEMO_PASSWORD=
# Set to 1 when served over HTTPS so the session cookie is marked Secure
PAYTRACE_HTTPS=0
# Bearer token for the integration API POST /api/v1/score (disabled when empty)
PAYTRACE_API_TOKEN=

# ---- Payment limits (₹ per payment; above the limit a payment is declined before scoring) ----
PAYTRACE_LIMIT_UPI=100000
PAYTRACE_LIMIT_CARD=500000
PAYTRACE_LIMIT_NETBANKING=1000000
PAYTRACE_LIMIT_CARD_POS=500000
PAYTRACE_LIMIT_CARD_ONLINE=500000

# ---- Engine ----
# Data + model the web app runs on: sparkov (default when trained) or v2 (original synthetic data)
PAYTRACE_APP_DATASET=
# Use only the last N history rows to rebuild customer state at startup (0 = all; smaller = faster start)
PAYTRACE_HISTORY_LIMIT=0
# Database file (default: paytrace.db in the project folder)
PAYTRACE_DB=

# ---- Admin analytics dashboard (Streamlit, optional) ----
# Dashboard users: name:role:sha256(SALT+password); roles viewer|analyst|admin. Empty = demo mode.
# Generate a hash with:  python -m src.auth <password>
PAYTRACE_SALT=
PAYTRACE_USERS=
# dataset shown by the Streamlit analytics dashboard only (not the web app)
PAYTRACE_DATASET=v2
PAYTRACE_FEEDBACK_LIMIT=200
KAFKA_BOOTSTRAP=localhost:9092
